def multisampling(a,l):
    '''Fonction réalisant f: resample pour chaque valeur de la liste choisie'''
    t0=t.time()
    for e in l :
        resample(a,e)
    t1=t.time()
    print(t1-t0)
    print("OK ! ")

# Fonction créée avec un pool de coeurs

def multimulti(a,l) :
    '''Fonction du même type que multisampling, mais en multi coeurs'''
    t0=t.time()
    with Pool(16) as p :
        for i in l :
            p.starmap(resample, [(a,i)])
    t1=t.time()
    print(t1-t0)
    print("OK !")

