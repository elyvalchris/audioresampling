def resample(a,srt) :
    '''Fonction rééchantillonnant l'audio choisi'''
    rsa = librosa.resample(a, orig_sr=sr, target_sr=srt)
    # Changement du sr
    out = f"{srt}Hz.wav"
    # Création du nouveau nom de fichier

    sf.write(out,rsa,srt)
    # Ecriture du nouveau fichier

    # Génération de charts
    d = librosa.stft(rsa, n_fft=2048, hop_length=512)
