# Partie 2
# Le but de cette partie est de comparer cette fois-ci les ratios écart à
# l'original / poids afin de maximiser une audibilité

def spec_db(a, sr_a):
    '''Renvoie le spectrogramme de l'udio choisi'''
    s = np.abs(librosa.stft(a, n_fft=2048))**2
    s_db = librosa.power_to_db(s, ref=np.max)


    return s_db,sr_a

def diff_spectro_moyenne(y0, sr0, y1, sr1):
    '''Renvoie la moyenne des écarts de spectres audio'''
    s0 = spec_db(y0, sr0)[0]
    s1 = spec_db(y1, sr1)[0]

    sr_min=min(sr0,sr1)
    k0 = int(s0.shape[0] * (sr_min / sr0))
    k1 = int(s1.shape[0] * (sr_min / sr1))
    s0c = s0[:k0, :]
    s1c = s1[:k1, :]

    j = min(s0c.shape[0], s1c.shape[0])
    k = min(s0c.shape[1], s1c.shape[1])
    s0c = s0c[:j, :k]
    s1c = s1c[:j, :k]

    d = s1c - s0c
    diff_moy = np.mean(np.abs(d))

    return diff_moy, d

def plot_diff_spectro(d, sr_min, hop_length=512, title="Diff spectrogramme (dB)"):
    '''Affiche la différence de spectrogrammes'''
    plt.figure()
    librosa.display.specshow(d, sr=sr_min, hop_length=hop_length,
                             x_axis="time", y_axis="hz", cmap="magma")
    plt.colorbar(label="Δ dB")
    plt.title(title)
    plt.tight_layout()
    plt.show()

def ratios_diff_poids(y0, sr0, l) :
    '''Renvoie les ratios diff/poids d'échantillonnages de y0 sur l'''
    srs = []
    poids = []
    diffs = []
    ratios = []

    for e in l :
        path = resample(y0, e)

        y1, sr1 = librosa.load(path, sr=None, mono=True)

        diff_moy = diff_spectro_moyenne(y0, sr0, y1, sr1)[0]

        s = os.path.getsize(path) - 45
        srs.append(e)
        poids.append(s)
        diffs.append(diff_moy)
        ratios.append(diff_moy / s)

    return np.array(srs), np.array(poids), np.array(diffs), np.array(ratios)

def affichage_ratios(y0, sr0, l):
    '''Affiche les ratios précédemment calculés'''
    copy = ratios_diff_poids(y0, sr0, l)
    srs = copy[0]
    poids = copy[1]
    ratios = copy[3]

    plt.figure()
    plt.plot(poids,ratios)
    plt.xlabel("Poids (octets)))
    plt.ylabel("Diff/poids ")
    plt.title("Ratio Diff / Poids")
    plt.show()
